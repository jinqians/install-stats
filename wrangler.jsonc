{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "install-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "install-stats",
      // No database_id: `wrangler deploy` (or the Deploy button) creates the
      // database, and the Worker creates its own tables.
      "migrations_dir": "migrations"
    }
  ],
  // What is counted (the scripts, Docker Hub repositories, the time zone) is
  // set on the stats page, not here, so this file is the same for everyone.
  // The stats page answers on the workers.dev address. A custom domain for it,
  // and a route for each script hostname of its own, are added in the
  // Cloudflare dashboard (the Worker → Settings → Domains & Routes); a deploy
  // leaves them alone, as no routes are listed here.
  "workers_dev": true,
  // Every hour, so that a day ends on time in any time zone: the days before
  // today are closed (their unique servers counted, the hashes behind them
  // deleted), and Docker Hub's pull counts are read once a day.
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
  // Secret (never in this file): ADMIN_PASSWORD, the stats page's password
}
